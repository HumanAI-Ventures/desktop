<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.apparae.agency</string>
    <key>ProgramArguments</key>
    <array>
        <string>__DAEMON_PATH__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/com.apparae.agency/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/com.apparae.agency/stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>APPARAE_DATA_DIR</key>
        <string>__HOME__/.apparae</string>
    </dict>
</dict>
</plist>
